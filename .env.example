# =====================================================================
# NewSec Chat — variáveis de ambiente
#
# COMO USAR: copie este arquivo para `.env.local` e preencha.
#
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   Linux/Mac:             cp .env.example .env.local
#
# O `.env.local` NUNCA vai para o GitHub (já está no .gitignore).
# O passo a passo de onde achar cada valor está em OWNER_SETUP_GUIDE.md.
# =====================================================================


# ---------------------------------------------------------------------
# 1. SUPABASE — OBRIGATÓRIO. Sem isto a aplicação não sobe.
#
# Onde achar: supabase.com > seu projeto > Project Settings > API
# ---------------------------------------------------------------------

# "Project URL". Começa com https:// e termina em .supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public". Esta chave PODE aparecer no navegador — é assim mesmo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role". NUNCA compartilhe. Ela ignora todas as regras de
# segurança do banco e é usada só pelo servidor e pelo worker.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta com o banco, usada por `npm run banco:aplicar` e pelos
# testes de isolamento. Onde achar: Project Settings > Database >
# Connection string > URI (troque [YOUR-PASSWORD] pela senha do banco).
SUPABASE_DB_URL=


# ---------------------------------------------------------------------
# 2. ENDEREÇO DA APLICAÇÃO — OBRIGATÓRIO em produção.
#
# É por este endereço que a Evolution API vai chamar o webhook. Enquanto
# for localhost, NENHUMA mensagem de WhatsApp vai chegar.
# ---------------------------------------------------------------------

NEXT_PUBLIC_URL_APLICACAO=http://localhost:3000

# Nome que aparece na barra lateral e no título das páginas.
NEXT_PUBLIC_NOME_APLICACAO=NewSec Chat


# ---------------------------------------------------------------------
# 3. EVOLUTION API — conectar números de WhatsApp.
#
# Sem isto, dá para usar a aplicação com um canal "SIMULADO" (que não
# envia nada a ninguém), mas nenhum número real conecta.
# ---------------------------------------------------------------------

# Endereço do servidor da Evolution, sem barra no final.
EVOLUTION_API_URL=

# A chave global definida na instalação da Evolution (AUTHENTICATION_API_KEY).
EVOLUTION_API_KEY=


# ---------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL.
#
# Sem isto, a aplicação funciona: toda conversa vai direto para
# atendimento humano. Nada fica sem resposta por falta desta chave.
# ---------------------------------------------------------------------

PROVEDOR_IA=OPENAI

# platform.openai.com > API keys. Começa com sk-
OPENAI_API_KEY=

# Modelo das conversas. O mini é bem mais barato e dá conta do
# atendimento; troque só se sentir necessidade.
OPENAI_MODELO_CONVERSA=gpt-4o-mini

# Modelo da análise de atendimentos e da leitura de imagens.
OPENAI_MODELO_ANALISE=gpt-4o

# Transcrição de áudio.
OPENAI_MODELO_TRANSCRICAO=whisper-1


# ---------------------------------------------------------------------
# 5. REDIS — a fila. OBRIGATÓRIO em produção.
#
# É a fila que processa mensagem recebida, chama a IA, envia resposta e
# roda campanha. Sem ela, as mensagens chegam e ficam paradas.
# ---------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# Só para desenvolvimento sem Redis: processa em memória, no próprio
# processo. NÃO funciona em produção e a aplicação recusa se tentar.
FILA_EM_MEMORIA=false


# ---------------------------------------------------------------------
# 6. GOOGLE SHEETS — importar leads de planilha. Opcional.
#
# console.cloud.google.com > APIs e serviços > Credenciais >
# ID do cliente OAuth (tipo: aplicativo da Web)
# ---------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Precisa ser EXATAMENTE igual ao que estiver cadastrado no Google, em
# "URIs de redirecionamento autorizados".
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integracoes/google/retorno


# ---------------------------------------------------------------------
# 7. OPERAÇÃO.
# ---------------------------------------------------------------------

# debug | info | warn | error
NIVEL_LOG=info
